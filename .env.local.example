# Spotify Developer Dashboard (https://developer.spotify.com/dashboard) app credentials.
# Rotate these before deploying — the original client ID/secret used by this project
# were hardcoded and committed to git history and must be treated as compromised.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# http://127.0.0.1:3000 in local dev, the canonical production URL when deployed.
# Spotify requires 127.0.0.1 rather than localhost for local-loopback redirect URIs.
NEXTAUTH_URL=http://127.0.0.1:3000

# Last.fm API key for song recommendations (track.getSimilar).
# Create one at https://www.last.fm/api/account/create — no OAuth, the key alone is enough.
LASTFM_API_KEY=
